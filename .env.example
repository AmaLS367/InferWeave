# Local development/live-test configuration. The library does not load .env files.
# Copy this file to .env and fill in credentials locally. Never commit .env.
# Live tests provision real GPUs and incur charges.
# Run the protected Modal flow from the repository root:
# uv run --env-file .env --extra modal pytest -m integration tests/test_modal_integration.py --strict-markers -ra

# Modal account credentials used for deployment (both required by the live test).
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Separate HTTP Proxy Tokens from Modal workspace settings, used for protected
# health/inference requests. Account credentials cannot replace these tokens.
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=

# Lightning Deployment platform auth: a user API key, not a scoped org key.
# The same API key authenticates HTTP endpoints as a Bearer token.
LIGHTNING_USER_ID=
LIGHTNING_API_KEY=
# Explicit owner/teamspace slug from Lightning. No LIGHTNING_ORG needed with this form.
LIGHTNING_TEAMSPACE=
# Merely configuring credentials never enables paid tests.
INFERWEAVE_LIGHTNING_INTEGRATION=0
# uv run --env-file .env --extra lightning pytest tests/test_lightning_integration.py -m integration --strict-markers -ra

# Multiple accounts: point to an accounts file (YAML/JSON) that names the variables
# holding each account's keys, e.g. MODAL_A_TOKEN_ID / RUNPOD_B_API_KEY.
# See docs/how-to/use-multiple-accounts.md and examples/accounts.example.yaml.
# INFERWEAVE_ACCOUNTS_FILE=examples/accounts.example.yaml
# Isolated interpreters for the Lightning and SkyPilot workers (separate venvs).
# INFERWEAVE_LIGHTNING_PYTHON=
# INFERWEAVE_SKYPILOT_PYTHON=

# Dedicated local state for manual examples; live tests use a temporary database.
INFERWEAVE_DEPLOYMENTS_PATH=.inferweave/test-deployments.db

# Optional RunPod test (Linux/macOS/WSL2, requires the runpod extra).
# Enable deliberately by setting INFERWEAVE_RUNPOD_INTEGRATION=1.
# RUNPOD_API_KEY=
# INFERWEAVE_RUNPOD_INTEGRATION=0
# INFERWEAVE_RUNPOD_GPU=L4
# INFERWEAVE_RUNPOD_MODEL=facebook/opt-125m
# INFERWEAVE_RUNPOD_READY_TIMEOUT_SECS=1500
# INFERWEAVE_RUNPOD_AUTOSTOP_MINS=15
# INFERWEAVE_RUNPOD_ALLOW_SPOT=0
